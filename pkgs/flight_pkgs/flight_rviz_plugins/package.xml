<?xml version="1.0"?>
<package format="3">
  <name>flight_rviz_plugins</name><version>0.1.0</version>
  <description>Independent RViz2 control and waypoint panel for flight_core APIs.</description>
  <maintainer email="nv@example.com">nv</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rviz_common</depend><depend>pluginlib</depend><depend>rclcpp</depend>
  <depend>rclcpp_action</depend><depend>flight_interfaces</depend>
  <depend>geometry_msgs</depend><depend>visualization_msgs</depend><depend>std_srvs</depend>
  <depend>qtbase5-dev</depend><depend>yaml-cpp</depend>
  <exec_depend>rviz2</exec_depend><exec_depend>rviz_default_plugins</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
