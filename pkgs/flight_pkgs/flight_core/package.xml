<?xml version="1.0"?>
<package format="3">
  <name>flight_core</name>
  <version>0.1.0</version>
  <description>Single-vehicle ROS 2 actions and waypoint missions with a MAVROS/PX4 backend.</description>
  <maintainer email="nv@example.com">nv</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>mavros_msgs</depend>
  <depend>flight_interfaces</depend>
